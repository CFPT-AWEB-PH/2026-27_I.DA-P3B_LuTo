# Copier ce fichier en .env et REMPLACER toutes les valeurs « change-moi ».
# Générer un mot de passe solide :  openssl rand -base64 24
APP_PORT=8080
# Interface d'écoute de l'app : 0.0.0.0 = tout le réseau local.
# Raspberry Pi en point d'accès Wi-Fi : 127.0.0.1 (l'app passe alors par le proxy HTTPS)
APP_BIND=0.0.0.0

DB_ROOT_PASSWORD=change-moi-root
DB_NAME=sabre_arbitrage
DB_USER=arbitrage_app
DB_PASS=change-moi-app

BASE_URL=/

# Fuseau horaire du serveur (toute l'appli se base sur cette heure)
TZ=Europe/Zurich

# Affiche les erreurs PHP détaillées (JAMAIS en production)
APP_DEBUG=0

# ── Raspberry Pi : Wi-Fi isolé + HTTPS (rempli par raspberry/install_wifi.sh) ──
# COMPOSE_PROFILES=pi
# SABRE_DOMAINE=sabre.lan
