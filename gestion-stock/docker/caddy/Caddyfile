{
	# HTTPS sans nom de domaine (HTTPS_IP, ex. 10.5.35.38) : certificat de l'autorité interne de Caddy
	# (Let's Encrypt ne délivre rien pour une adresse IP privée). Un navigateur n'envoie pas de SNI vers une IP
	# et, derrière Docker, Caddy ne voit que l'adresse du conteneur : default_sni désigne le bon certificat.
	default_sni {$HTTPS_IP:localhost}
	skip_install_trust
	# Une connexion lente ne doit pas occuper le serveur indéfiniment
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

# Réglages communs à toutes les adresses du site
(app) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		# Connexion Google, le jour où elle sera en place : ajouter https://accounts.google.com à form-action
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	# HSTS uniquement en HTTPS : en HTTP, il serait ignoré par les navigateurs
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	request_body {
		max_size 6MB
	}

	handle /api/* {
		root * /app/public
		rewrite * /index.php
		php_fastcgi php:9000
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		# Revalidation systématique (ETag) : sw.js doit toujours être comparé au serveur pour détecter
		# une nouvelle version, et les autres fichiers sont servis par le service worker quand il est actif
		header Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		file_server
	}

	# Ni le jeton des liens de connexion ni le jeton CSRF dans les journaux
	# (Caddy masque déjà les cookies et l'en-tête Authorization)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
				request>headers>X-Csrf-Token delete
			}
		}
	}
}

# ":80" : HTTP, sans redirection (poste du Pi via localhost, développement). Nom de domaine : HTTPS automatique
# (Let's Encrypt) et redirection du HTTP.
{$SITE_ADDRESS::80} {
	import app
}

# HTTPS sur l'adresse IP du serveur. Sans HTTPS_IP (docker-compose : certificat.invalid), ce bloc ne sert à rien.
https://{$HTTPS_IP:certificat.invalid} {
	tls internal
	import app
}

# HTTP sur l'adresse IP : seulement le certificat racine à installer sur les appareils (il doit se télécharger
# sans avertissement) ; tout le reste est redirigé vers HTTPS.
http://{$HTTPS_IP:certificat.invalid} {
	handle /certificat.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"gestion-stock-certificat.crt\""
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
