# Copier en .env (chmod 600) et remplir. Ne jamais versionner .env.
# Sur le Pi, scripts/init-env.sh le crée automatiquement avec des mots de passe aléatoires.

APP_ENV=production

# Adresse servie par Caddy : ":80" en HTTP (et le poste du Pi via localhost), ou un nom de domaine pour HTTPS Let's Encrypt
# (voir docs/ARCHITECTURE.md §6)
SITE_ADDRESS=:80
APP_DOMAIN=
# URL publique, utilisée dans les liens de connexion générés sur le serveur
APP_URL=https://10.5.35.30
# HTTPS sans nom de domaine : adresse IP du serveur (certificat de l'autorité interne de Caddy). Vide : pas de HTTPS sur IP.
HTTPS_IP=

# MariaDB (mots de passe longs et aléatoires)
DB_NAME=gestion_stock
DB_USER=gestion_stock
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Google OAuth 2.0 / OpenID Connect (Google Cloud Console > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connexion par lien à usage unique généré en SSH (bin/login-link.php) : 1 = activée
AUTH_LOGIN_LINKS=1

# Durée des sessions : maximale et sans activité (jours)
SESSION_LIFETIME_DAYS=30
SESSION_IDLE_DAYS=7

# Adresse du premier administrateur, prise en compte à sa première connexion uniquement
BOOTSTRAP_ADMIN_EMAIL=

# Sauvegardes (heure locale Europe/Zurich, dossier sur l'hôte)
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_HOST_DIR=./backups
