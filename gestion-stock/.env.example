# Copier en .env (chmod 600) et remplir. Ne jamais versionner .env.
# Sur le Pi, scripts/init-env.sh le crée automatiquement avec des mots de passe aléatoires.

APP_ENV=production

# Adresse servie par Caddy : ":80" en HTTP local, ou le nom de domaine pour activer HTTPS
# (voir docs/ARCHITECTURE.md §6)
SITE_ADDRESS=:80
APP_DOMAIN=

# MariaDB (mots de passe longs et aléatoires)
DB_NAME=gestion_stock
DB_USER=gestion_stock
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Google OAuth 2.0 / OpenID Connect (Google Cloud Console > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresse du premier administrateur, prise en compte à sa première connexion uniquement
BOOTSTRAP_ADMIN_EMAIL=

# Sauvegardes (heure locale Europe/Zurich, dossier sur l'hôte)
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_HOST_DIR=./backups
